<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Добавить сервер"
        android:textColor="#F5F7FB"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:paddingBottom="20dp" />

    <LinearLayout
        android:id="@+id/opt_manual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_dialog_option">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="✎"
            android:textSize="18sp"
            android:textColor="#7C5CFF"
            android:gravity="center"
            android:background="@drawable/bg_flag_box" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Ввести вручную"
            android:textColor="#F5F7FB"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/opt_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/bg_dialog_option">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="⌨"
            android:textSize="18sp"
            android:textColor="#7C5CFF"
            android:gravity="center"
            android:background="@drawable/bg_flag_box" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Ввести код"
            android:textColor="#F5F7FB"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

</LinearLayout>
