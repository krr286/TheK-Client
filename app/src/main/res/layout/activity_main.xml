<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@android:color/transparent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Dark" />

        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/drawer_panel"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#0A0E1A"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/bg_drawer_header">

            <TextView
                android:id="@+id/drawer_logo_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THEK"
                android:textColor="#FFFFFF"
                android:textSize="42sp"
                android:textStyle="bold|italic"
                android:letterSpacing="0.05"
                android:fontFamily="sans-serif-black"
                android:shadowColor="#707C5CFF"
                android:shadowDx="0"
                android:shadowDy="4"
                android:shadowRadius="16"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="30dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="P R O X Y   C L I E N T"
                android:textColor="#A0A8BF"
                android:textSize="10sp"
                android:letterSpacing="0.25"
                android:fontFamily="sans-serif-medium"
                android:layout_gravity="bottom|center_horizontal"
                android:gravity="center"
                android:paddingBottom="18dp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="20dp"
            android:layout_marginTop="16dp"
            android:background="?android:attr/selectableItemBackground">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_home" android:tint="#7C5CFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:text="Главная" android:textColor="#F5F7FB" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_telegram"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="20dp"
            android:visibility="gone"
            android:background="?android:attr/selectableItemBackground">
            <TextView android:layout_width="22dp" android:layout_height="22dp" android:text="✈" android:textSize="18sp" android:textColor="#7C5CFF" android:gravity="center" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:text="Для Telegram" android:textColor="#F5F7FB" android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_servers"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="20dp"
            android:background="?android:attr/selectableItemBackground">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_servers" android:tint="#7C5CFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:text="Сервера" android:textColor="#F5F7FB" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:background="#1FFFFFFF" />

        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="20dp"
            android:background="?android:attr/selectableItemBackground">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_settings" android:tint="#7C5CFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:text="Настройки" android:textColor="#F5F7FB" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_about"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="20dp"
            android:background="?android:attr/selectableItemBackground">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_info" android:tint="#7C5CFF" />
            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="О приложении"
                android:textColor="#F5F7FB"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="P R O X Y   C L I E N T"
            android:textColor="#6B7290"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingBottom="20dp"
            android:letterSpacing="0.25" />
    </LinearLayout>

    <!-- Декор для drawer (звёзды) -->
    <FrameLayout
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_decor"
            android:scaleType="centerCrop"
            android:alpha="0.6"
            android:importantForAccessibility="no" />
    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>
