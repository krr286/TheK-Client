<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Граффити-декор по бокам -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_graffiti_decor"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Блок кнопки -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="32dp"
            android:paddingBottom="20dp"
            android:minHeight="300dp">

            <FrameLayout
                android:id="@+id/connect_button"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal|top"
                android:background="@drawable/bg_connect_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/connect_icon"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_power_circle_big"
                    android:tint="#F5F7FB" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/home_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="НЕ ЗАЩИЩЕНО"
                    android:textColor="#EF4444"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <TextView
                    android:id="@+id/current_server"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text=""
                    android:textColor="#A0A8BF"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Раздел серверов -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="10dp">

            <View
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:background="#7C5CFF"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="СЕРВЕРА"
                android:textColor="#A0A8BF"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.25" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <ImageView
                android:id="@+id/home_refresh"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_refresh"
                android:tint="#7C5CFF"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/servers_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingBottom="14dp"
            android:clipToPadding="false" />

    </LinearLayout>
</FrameLayout>
