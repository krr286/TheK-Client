<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/bg_server_card">

    <TextView
        android:id="@+id/srv_flag"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="●"
        android:textSize="22sp"
        android:gravity="center"
        android:background="@drawable/bg_flag_box" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/srv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сервер"
            android:textColor="#F5F7FB"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/srv_addr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0.0.0:0"
                android:textColor="#A0A8BF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/srv_ping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#A0A8BF"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/srv_load"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:layout_marginEnd="8dp"
        android:textColor="#A0A8BF" />

    <TextView
        android:id="@+id/srv_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✓"
        android:textColor="#7C5CFF"
        android:textSize="22sp"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/srv_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Открыть"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_btn_telegram"
        android:visibility="gone" />
</LinearLayout>
