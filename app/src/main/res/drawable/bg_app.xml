<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- База — очень тёмная -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#05070F" />
        </shape>
    </item>

    <!-- Основной градиент: тёмный центр → синеватый низ -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="120%"
                android:centerX="0.5"
                android:centerY="0.35"
                android:startColor="#00000000"
                android:centerColor="#080C18"
                android:endColor="#1A1F3A" />
        </shape>
    </item>

    <!-- Свечение СНИЗУ — фиолетово-синее -->
    <item android:gravity="bottom">
        <shape android:shape="oval">
            <size android:width="800dp" android:height="500dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="450dp"
                android:startColor="#4A7C5CFF"
                android:centerColor="#255B3FE0"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Свечение слева по центру — мягкое синее -->
    <item android:gravity="start|center_vertical">
        <shape android:shape="oval">
            <size android:width="400dp" android:height="700dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="300dp"
                android:startColor="#303B82F6"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Свечение справа по центру — мягкое фиолетовое -->
    <item android:gravity="end|center_vertical">
        <shape android:shape="oval">
            <size android:width="400dp" android:height="700dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="300dp"
                android:startColor="#307C5CFF"
                android:endColor="#00000000" />
        </shape>
    </item>

</layer-list>
